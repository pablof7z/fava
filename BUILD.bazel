# Root package. Exports the crate_universe source of truth.
exports_files([
    ".bg-shell/simple-groups-semantic-catalog.jsonl",
    "Cargo.lock",
    "Cargo.toml",
    "docs/internals/vocabulary.toml",
    "docs/issues/0027-simple-group-relay-input-boundary.md",
])

# `bazel run //:fmt` rewrites every crate's sources in place, the way
# `cargo fmt` does. The read-only counterpart is `--config=fmt-check`,
# which reports without writing (see .bazelrc).
alias(
    name = "fmt",
    actual = "@rules_rust//tools/rustfmt",
    visibility = ["//visibility:public"],
)
