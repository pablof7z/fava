load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "lib",
    crate_name = "fava_nip02",
    srcs = glob(["src/**/*.rs"]),
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + [
        "//crates/fava-query:lib",
        "//crates/fava-state:lib",
        "//crates/fava-write:lib",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "unit_tests",
    crate_name = "fava_nip02_tests",
    srcs = glob(["src/**/*.rs"]),
    edition = crate_edition(),
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal = True, normal_dev = True) + [
        "//crates/fava-query-standard:lib",
        "//crates/fava-query:lib",
        "//crates/fava-state:lib",
        "//crates/fava-write:lib",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
    compile_data = ["Cargo.toml"],
)

rust_test(
    name = "public_api",
    crate_name = "fava_nip02_public_api",
    srcs = ["tests/public_api.rs"],
    edition = crate_edition(),
    deps = [
        ":lib",
        "//crates/fava-query:lib",
        "//crates/fava-state:lib",
        "//crates/fava-write:lib",
    ],
)

# `tests/architecture.rs` reads this BUILD file and the crate's Cargo.toml and
# sources through `include_str!`, so every file it reads is compile_data. Its
# recursive source walk resolves through `BUILD_WORKSPACE_DIRECTORY` when Bazel
# sets it and falls back to `CARGO_MANIFEST_DIR` otherwise.
rust_test(
    name = "architecture",
    srcs = ["tests/architecture.rs"],
    crate_name = "fava_nip02_architecture",
    edition = crate_edition(),
    deps = [],
    data = [
        "//crates/fava-observe:architecture_sources",
        "//crates/fava-publication:architecture_sources",
        "//crates/fava-query:architecture_sources",
        "//crates/fava-write:architecture_sources",
        "//crates/fava:architecture_sources",
    ],
    compile_data = glob(["src/**/*.rs"]) + [
        "BUILD.bazel",
        "Cargo.toml",
    ],
)
