# First-party BUILD for the `fava-query-standard` crate. Third-party deps
# come from @crates via all_crate_deps(); first-party path deps are
# explicit.

load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "lib",
    crate_name = "fava_query_standard",
    srcs = glob(["src/**/*.rs"]),
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + [
        "//crates/fava-query:lib",
        "//crates/fava-state:lib",
        "//crates/fava-write:lib",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "source_merge",
    srcs = ["tests/source_merge.rs"],
    crate_name = "source_merge",
    edition = crate_edition(),
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal = True, normal_dev = True) + [
        ":lib",
        "//crates/fava-query:lib",
        "//crates/fava-state:lib",
        "//crates/fava-write:lib",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
    compile_data = ["Cargo.toml"],
)

rust_test(
    name = "multi_kind",
    srcs = ["tests/multi_kind.rs"],
    crate_name = "multi_kind",
    edition = crate_edition(),
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal = True, normal_dev = True) + [
        ":lib",
        "//crates/fava-query:lib",
        "//crates/fava-state:lib",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
    compile_data = ["Cargo.toml"],
)

rust_test(
    name = "relay_authority",
    srcs = ["tests/relay_authority.rs"],
    crate_name = "relay_authority",
    edition = crate_edition(),
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal = True, normal_dev = True) + [
        ":lib",
        "//crates/fava-query:lib",
        "//crates/fava-state:lib",
        "//crates/fava-write:lib",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
    compile_data = ["Cargo.toml"],
)

rust_test(
    name = "live_relay_source",
    srcs = ["tests/live_relay_source.rs"],
    crate_name = "live_relay_source",
    edition = crate_edition(),
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal = True, normal_dev = True) + [
        ":lib",
        "//crates/fava-query:lib",
        "//crates/fava-state:lib",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
    compile_data = [
        "Cargo.toml",
        "src/lib.rs",
    ],
)
