# First-party BUILD for the `fava-event-cache-memory` crate. Third-party
# deps come from @crates via all_crate_deps(); first-party path deps are
# explicit.

load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

filegroup(
    name = "architecture_sources",
    srcs = glob(["**/*.rs"]),
    visibility = ["//visibility:public"],
)

rust_library(
    name = "lib",
    crate_name = "fava_event_cache_memory",
    srcs = glob(["src/**/*.rs"]),
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + [
        "//crates/fava-relay:lib",
        "//crates/fava-event-cache:lib",
        "//crates/fava-query:lib",
        "//crates/fava-state:lib",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "unit_tests",
    crate_name = "fava_event_cache_memory_tests",
    srcs = glob(["src/**/*.rs"]),
    edition = crate_edition(),
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal = True, normal_dev = True) + [
        "//crates/fava-relay:lib",
        "//crates/fava-event-cache:lib",
        "//crates/fava-query:lib",
        "//crates/fava-state:lib",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
    compile_data = ["Cargo.toml"],
)

rust_test(
    name = "cache_lifecycle",
    srcs = ["tests/cache_lifecycle.rs"],
    crate_name = "cache_lifecycle",
    edition = crate_edition(),
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal = True, normal_dev = True) + [
        "//crates/fava-relay:lib",
        ":lib",
        "//crates/fava-event-cache:lib",
        "//crates/fava-query:lib",
        "//crates/fava-state:lib",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
    compile_data = ["Cargo.toml"],
)
