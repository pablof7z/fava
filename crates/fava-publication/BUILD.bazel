load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "lib",
    crate_name = "fava_publication",
    srcs = glob(["src/**/*.rs"]),
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + [
        "//crates/fava-delivery:lib",
        "//crates/fava-publisher:lib",
        "//crates/fava-query:lib",
        "//crates/fava-routing:lib",
        "//crates/fava-session:lib",
        "//crates/fava-signer:lib",
        "//crates/fava-state:lib",
        "//crates/fava-transport:lib",
        "//crates/fava-write:lib",
        "//crates/fava-write-store:lib",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "owner_lifecycle",
    srcs = [
        "tests/owner_lifecycle.rs",
        "tests/owner_lifecycle/harness.rs",
    ],
    crate_name = "owner_lifecycle",
    edition = crate_edition(),
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal = True, normal_dev = True) + [
        ":lib",
        "//crates/fava-delivery:lib",
        "//crates/fava-delivery-standard:lib",
        "//crates/fava-publisher:lib",
        "//crates/fava-query-standard:lib",
        "//crates/fava-routing:lib",
        "//crates/fava-session:lib",
        "//crates/fava-signer:lib",
        "//crates/fava-state:lib",
        "//crates/fava-transport:lib",
        "//crates/fava-write:lib",
        "//crates/fava-write-store:lib",
        "//crates/fava-write-store-memory:lib",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
    compile_data = ["Cargo.toml"],
)
