load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

filegroup(
    name = "architecture_sources",
    srcs = glob(["src/**/*.rs"]),
)

rust_library(
    name = "lib",
    crate_name = "fava_simple_groups",
    srcs = glob(["src/**/*.rs"]),
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + [
        "//crates/fava-query:lib",
        "//crates/fava-state:lib",
        "//crates/fava-write:lib",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    compile_data = [
        "Cargo.toml",
        "README.md",
    ],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "unit_tests",
    crate_name = "fava_simple_groups_tests",
    srcs = glob(["src/**/*.rs"]),
    edition = crate_edition(),
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal = True, normal_dev = True) + [
        "//crates/fava-query:lib",
        "//crates/fava-state:lib",
        "//crates/fava-write:lib",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
    compile_data = ["README.md"],
)

rust_test(
    name = "public_api",
    crate_name = "fava_simple_groups_public_api",
    srcs = ["tests/public_api.rs"],
    edition = crate_edition(),
    deps = [
        ":lib",
        "//crates/fava-query:lib",
        "//crates/fava-state:lib",
        "//crates/fava-write:lib",
    ],
)

rust_test(
    name = "architecture",
    crate_name = "fava_simple_groups_architecture",
    srcs = ["tests/architecture.rs"],
    edition = crate_edition(),
    deps = [
        ":lib",
        "//crates/fava-query:lib",
        "//crates/fava-write:lib",
    ],
    compile_data = glob(["src/*.rs"]) + [
        "Cargo.toml",
        "BUILD.bazel",
        "README.md",
        "//:.bg-shell/simple-groups-semantic-catalog.jsonl",
    ],
)
