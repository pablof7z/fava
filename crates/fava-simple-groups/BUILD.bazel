load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

filegroup(
    name = "architecture_sources",
    srcs = glob(["**/*.rs"]),
    visibility = ["//visibility:public"],
)

rust_library(
    name = "lib",
    crate_name = "fava_simple_groups",
    srcs = glob(["src/**/*.rs"]),
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + [
        "//crates/fava-query:lib",
        "//crates/fava-relay:lib",
        "//crates/fava-state:lib",
        "//crates/fava-write:lib",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "unit_tests",
    crate_name = "fava_simple_groups_tests",
    srcs = glob(["src/**/*.rs"]),
    edition = crate_edition(),
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal = True, normal_dev = True) + [
        "//crates/fava-query:lib",
        "//crates/fava-state:lib",
        "//crates/fava-write:lib",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
)

rust_test(
    name = "public_api",
    crate_name = "fava_simple_groups_public_api",
    srcs = ["tests/public_api.rs"],
    edition = crate_edition(),
    deps = [
        ":lib",
        "//crates/fava:lib",
        "//crates/fava-query:lib",
        "//crates/fava-state:lib",
        "//crates/fava-write:lib",
    ],
)

rust_test(
    name = "architecture",
    crate_name = "fava_simple_groups_architecture",
    srcs = ["tests/architecture.rs"],
    edition = crate_edition(),
    deps = [
        ":lib",
        "//crates/fava-query:lib",
        "//crates/fava-write:lib",
    ],
    compile_data = [
        "Cargo.toml",
        "BUILD.bazel",
        "src/lib.rs",
    ],
    data = [
        ":architecture_sources",
        "//crates/fava-query:architecture_sources",
        "//crates/fava-state:architecture_sources",
        "//crates/fava-write:architecture_sources",
        "//crates/fava:architecture_sources",
    ],
)

rust_test(
    name = "exact_host_records",
    crate_name = "exact_host_records",
    srcs = ["tests/exact_host_records.rs"],
    edition = crate_edition(),
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal = True, normal_dev = True) + [
        ":lib",
        "//crates/fava-query:lib",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
    compile_data = ["Cargo.toml"],
)
