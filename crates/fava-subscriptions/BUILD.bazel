load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "lib",
    crate_name = "fava_subscriptions",
    srcs = glob(["src/**/*.rs"]),
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + [
        "//crates/fava-query:lib",
        "//crates/fava-state:lib",
        "//crates/fava-transport:lib",
        "//crates/fava-wire:lib",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "tag_values",
    crate_name = "tag_values",
    srcs = ["tests/tag_values.rs"],
    edition = crate_edition(),
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal = True, normal_dev = True) + [
        ":lib",
        "//crates/fava-query:lib",
        "//crates/fava-wire:lib",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
    compile_data = ["Cargo.toml"],
)

