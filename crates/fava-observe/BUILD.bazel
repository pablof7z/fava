# First-party BUILD for the `fava-observe` crate. Third-party deps come from
# @crates via all_crate_deps(); first-party path deps are explicit.

load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_library")

# Source set exported for the cross-crate architecture gates that assert the
# universal owners stay kind-blind.
filegroup(
    name = "architecture_sources",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
)

rust_library(
    name = "lib",
    crate_name = "fava_observe",
    srcs = glob(["src/**/*.rs"]),
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + [
        "//crates/fava-diagnostics:lib",
        "//crates/fava-event-cache:lib",
        "//crates/fava-ingest:lib",
        "//crates/fava-query:lib",
        "//crates/fava-routing:lib",
        "//crates/fava-runtime:lib",
        "//crates/fava-state:lib",
        "//crates/fava-subscriptions:lib",
        "//crates/fava-transport:lib",
        "//crates/fava-wire:lib",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
)
